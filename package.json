{
  "name": "gmail-txn-parser",
  "version": "0.1.0",
  "description": "Watches Gmail (and SMS via an iOS Shortcut) for bank transaction alerts, parses them, categorizes spend, and splits expenses with friends via a self-hosted PWA.",
  "license": "MIT",
  "author": "akki251",
  "repository": {
    "type": "git",
    "url": "https://github.com/akki251/gmail-txn-parser"
  },
  "private": true,
  "scripts": {
    "test": "node test.js",
    "test:split": "node test-split-flow.js",
    "test:sms": "node test-sms.js",
    "test:nontransactional": "node test-nontransactional.js",
    "test:parser": "node tests/parser.test.js",
    "test:ci": "node tests/parser.test.js",
    "test:stats": "node test-pipeline-stats.js",
    "test:matching": "node test-matching-engine.js",
    "test:dedup": "node test-dedup-integration.js",
    "fetch": "node fetchAndParse.js",
    "cli": "node cli.js",
    "serve": "node server.js",
    "mobile": "npm --prefix mobile start",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android"
  },
  "dependencies": {
    "googleapis": "^144.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
